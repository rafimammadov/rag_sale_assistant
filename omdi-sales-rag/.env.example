# Application
APP_NAME=OMDI Sales RAG
ENVIRONMENT=development
PUBLIC_BASE_URL=http://localhost:8000
DATA_DIR=./data
DATABASE_URL=sqlite:///./data/app.db
ADMIN_API_KEY=change-this-admin-key
ORDER_ACTION_SECRET=change-this-order-action-secret
MAX_UPLOAD_MB=30

# Semantic vector database
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=sales_knowledge

# Embeddings: "hash" works offline for a demo; use "openai" in production.
# Your existing OpenAI-compatible Qwen embedding service can be used here.
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=384

# Chat model: "mock" works without credentials; use "openai" for OpenAI,
# vLLM, LM Studio, Ollama's OpenAI endpoint, or another compatible server.
LLM_PROVIDER=mock
LLM_MODEL=gpt-4.1-mini
LLM_BASE_URL=
LLM_API_KEY=
LLM_JSON_MODE=true

# Telegram channel. Create a bot with @BotFather, then start the optional
# Compose profile shown in the README. Long polling does not require a webhook.
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_COMPANY_SLUG=yigit-aluminium
TELEGRAM_APP_BASE_URL=http://app:8000
TELEGRAM_PUBLIC_BASE_URL=http://localhost:8000
TELEGRAM_POLL_TIMEOUT_SECONDS=30

# Website scraper
SCRAPER_USER_AGENT=OMDI-Sales-RAG/0.1 (+company-knowledge-indexer)
SCRAPER_TIMEOUT_SECONDS=20
SCRAPER_MAX_RESPONSE_MB=5
SCRAPER_ALLOW_PRIVATE_NETWORKS=false

# Company notification options. If neither is configured, orders are written
# to DATA_DIR/outbox so the approval gate remains testable.
ORDER_WEBHOOK_URL=
ORDER_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
